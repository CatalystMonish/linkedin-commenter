{
  "manifest_version": 3,
  "name": "LinkedIn Comment Tracker",
  "version": "0.1.0",
  "minimum_chrome_version": "111",
  "description": "Counts the comments you post on LinkedIn. Daily, weekly and monthly totals, on-device only.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "LinkedIn Comment Tracker",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "js": [
        "src/interceptor.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "js": [
        "src/lib/constants.js",
        "src/lib/dates.js",
        "src/lib/storage.js",
        "src/bridge.js",
        "src/dom-detect.js",
        "src/widget/widget.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
